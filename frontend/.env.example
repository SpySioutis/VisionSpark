# Copy to .env to override defaults for local development.
# Backend base URL for all API calls. "/" means same origin (recommended:
# works over both HTTP and HTTPS; the dev server proxies to the backend).
VITE_BACKEND_URL=/
# To call a backend on another host/port instead:
# VITE_BACKEND_URL=http://localhost:8000
# Uncomment to serve the dev frontend over plain HTTP (upload-only, no phone camera).
# VITE_HTTPS=0
