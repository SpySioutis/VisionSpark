# VisionSpark example environment. Placeholders only — never real credentials.
# Copy relevant values to frontend/.env for local Vite development.

# Backend base URL used by the frontend for all API calls (health, segment, ask).
# "/" means same origin (recommended: works over both HTTP and HTTPS).
VITE_BACKEND_URL=/
# Uncomment to serve the dev frontend over plain HTTP (upload-only, no phone camera).
# VITE_HTTPS=0
